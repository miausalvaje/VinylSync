# Optional ACRCloud credentials.
ACR_HOST=
ACR_ACCESS_KEY=
ACR_ACCESS_SECRET=

# Optional AudD credential.
AUDD_API_TOKEN=

# Optional path override for the YAML configuration file.
VINYL_LYRICS_CONFIG=config.yaml

# User authentication: Admin credentials
# Generate password hash with:
# python -c "import hashlib, secrets; salt=secrets.token_hex(16); key=hashlib.pbkdf2_hmac('sha256', b'TU_PASSWORD', salt.encode(), 100000).hex(); print(f'pbkdf2:sha256:100000${salt}${key}')"
# (or plain sha256 hex: python -c "import hashlib; print(hashlib.sha256(b'TU_PASSWORD').hexdigest())")
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Optional: Persistent secret key for signing user session JWT tokens
VINYLSYNC_SECRET_KEY=
